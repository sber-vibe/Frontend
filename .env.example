# Адрес backend (Spring/FastAPI). Next.js проксирует /api/* на этот адрес.
BACKEND_URL=http://localhost:8080

# true — backend сам определяет тип документа по содержимому (AI/OCR),
# поле type при загрузке не отправляется. false — специалист выбирает тип вручную
# (текущий контракт Java-заготовки, где type обязателен).
NEXT_PUBLIC_AUTO_CLASSIFY=false

# Порог уверенности модели, ниже которого тип требует подтверждения специалиста.
NEXT_PUBLIC_CONFIDENCE_THRESHOLD=0.8

# Keycloak (OIDC, Authorization Code + PKCE, public client). Пусто — демо-вход без Keycloak.
# Пример: http://localhost:8180/realms/subsidy
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
